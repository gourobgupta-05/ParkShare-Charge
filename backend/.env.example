# Server
PORT=5000

# MongoDB Atlas — shared team cluster: parkshare-cluster
# Org: TAMAL DEB's Org - 2026-03-05  |  Project: ParkShare-Charge
# Get YOUR OWN connection string from: Atlas -> parkshare-cluster -> Connect -> Drivers -> Node.js
# Each teammate uses their own DB user credentials (Atlas -> Database Access),
# but all point at the same cluster/database so everyone reads/writes shared data.
MONGO_URI=mongodb+srv://<your_db_username>:<your_db_password>@parkshare-cluster.xxxxx.mongodb.net/parkshare?retryWrites=true&w=majority
