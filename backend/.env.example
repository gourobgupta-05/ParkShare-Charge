# ============================================================================
# ParkShare & Charge — BACKEND ENVIRONMENT
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Variables are grouped by which member's feature needs them.
# ============================================================================

# ---------------------------------------------- SHARED (initializer) -------
NODE_ENV=development
PORT=5000
# Atlas SRV string. Use YOUR OWN database name so you don't wipe teammates' data:
# parkshare_tdn | parkshare_gg | parkshare_mi | parkshare_smr | parkshare_demo
MONGO_URI=
MONGO_DB_NAME=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
QR_PASS_SECRET=
QR_PASS_TTL_MIN=15

BCRYPT_SALT_ROUNDS=10
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=dev

# 2FA / OTP (common auth). Leave SMS_PROVIDER=mock — real SMS needs paid credit.
SMS_PROVIDER=mock
SMS_SENDER_ID=
OTP_TTL_SECONDS=300
OTP_LENGTH=6
GREENWEB_API_TOKEN=
GREENWEB_BASE_URL=

# ------------------------------------------------- TAMAL DEB NATH [TDN] ----
GEO_SEARCH_MIN_RADIUS_KM=1
GEO_SEARCH_MAX_RADIUS_KM=5
GEO_SEARCH_MAX_RESULTS=50

PAYMENT_PROVIDER=mock
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_SANDBOX_BASE_URL=https://sandbox.sslcommerz.com
SSLCZ_SUCCESS_URL=
SSLCZ_FAIL_URL=
SSLCZ_IPN_URL=

# Declared but intentionally blank — bKash merchant approval is pending.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX_BASE_URL=

ESCROW_AUTO_RELEASE_HOURS=24
ESCROW_HOLD_EXPIRY_MINUTES=10
WALLET_MAX_TOPUP_POISHA=5000000
MALL_HOURS_BUFFER_MINUTES=15
MALL_HOURS_WORKER_ENABLED=true
MALL_HOURS_WORKER_INTERVAL_MS=300000

# --------------------------------------------------- GOUROB GUPTA [GG] -----
SLOT_LOCK_TTL_SECONDS=600
MIN_BOOKING_MINUTES=30
MAX_BOOKING_HOURS=12
BOOKING_BUFFER_MINUTES=10
CALENDAR_SLOT_MINUTES=30
CALENDAR_WORKER_ENABLED=true
CALENDAR_WORKER_INTERVAL_MS=120000
REVIEW_MIN_LENGTH=10
REVIEW_EDIT_WINDOW_HOURS=24

BERC_RATE_VERSION=2024-02
TARIFF_PEAK_START=17
TARIFF_PEAK_END=23
TARIFF_MULTIPLIER_DEFAULT=1
VAT_RATE=0.15

INVOICE_STORAGE_DIR=./uploads/invoices
INVOICE_ISSUER_NAME=ParkShare & Charge Ltd.
INVOICE_ISSUER_ADDRESS=Dhaka, Bangladesh
INVOICE_BIN_NUMBER=
INVOICE_SERIES_PREFIX=PSC

# --------------------------------------------------- MAIDUL ISLAM [MI] -----
MAPBOX_SERVER_TOKEN=
MAPBOX_DIRECTIONS_URL=https://api.mapbox.com/directions/v5/mapbox
NAV_PROFILE=driving-traffic
NAV_ETA_CACHE_TTL_SECONDS=60

IOT_TICK_INTERVAL_MS=3000
IOT_SIM_SEED=471
IOT_MAX_KW=22
IOT_VOLTAGE_NOMINAL=220
IOT_FAULT_PROBABILITY=0.01
IOT_READING_RETENTION_HOURS=48

SOCKET_PATH=/socket.io
SOCKET_PING_INTERVAL_MS=25000

CHAT_MESSAGE_MAX_LENGTH=1000
CHAT_HISTORY_PAGE_SIZE=50
CHAT_ENCRYPTION_KEY=

PROMO_MAX_DISCOUNT_POISHA=50000
PROMO_CASE_SENSITIVE=false

# --------------------------------------------- S. MOONTAHA RAHMAN [SMR] ----
GEOFENCE_RADIUS_M=15
GEOFENCE_MIN_ACCURACY_M=50
GEOFENCE_POLL_SECONDS=10
ALLOW_MOCK_LOCATION=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_DOC_MIME_TYPES=image/jpeg,image/png,application/pdf
NID_MIN_LENGTH=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PLATFORM_COMMISSION_RATE=0.12
PAYOUT_MIN_BALANCE_POISHA=50000
PAYOUT_BATCH_CRON=0 2 * * *
PAYOUT_HOLD_DAYS=1

PENALTY_GRACE_MINUTES=15
PENALTY_RATE_POISHA_PER_MIN=500
PENALTY_MAX_POISHA=200000
PENALTY_WORKER_CRON=*/5 * * * *
PENALTY_CATCHUP_ON_BOOT=true
PENALTY_WORKER_ENABLED=true
PENALTY_WORKER_INTERVAL_MS=60000
PENALTY_WARN_BEFORE_MINUTES=10

PUSH_PROVIDER=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key in quotes with literal \n sequences — config/env.js unescapes it.
FIREBASE_PRIVATE_KEY=
