# ============================================================================
# ParkShare & Charge — FRONTEND ENVIRONMENT
# Copy to frontend/.env.local. NEVER commit .env.local.
#
# ⚠️ EVERYTHING PREFIXED NEXT_PUBLIC_ IS SHIPPED TO THE BROWSER AND READABLE
#    BY ANYONE. No secret goes here. The Mapbox token must be a PUBLIC token
#    with URL restrictions (localhost + your Vercel domain).
# ============================================================================

# ------------------------------------------------ SHARED (initializer) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_PATH=/socket.io
NEXT_PUBLIC_APP_NAME=ParkShare & Charge
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka

# --------------------------------------------------- TAMAL DEB NATH [TDN] --
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_DEFAULT_LAT=23.8103
NEXT_PUBLIC_DEFAULT_LNG=90.4125
NEXT_PUBLIC_DEFAULT_ZOOM=13
NEXT_PUBLIC_SEARCH_RADIUS_DEFAULT_KM=3
NEXT_PUBLIC_ENABLE_SSLCZ_TOPUP=false

# ------------------------------------------------------ GOUROB GUPTA [GG] --
NEXT_PUBLIC_CALENDAR_SLOT_MINUTES=30
NEXT_PUBLIC_MAX_BOOKING_HOURS=12
NEXT_PUBLIC_VAT_RATE_DISPLAY=0.15
NEXT_PUBLIC_REVIEW_MIN_LENGTH=10

# ------------------------------------------------------ MAIDUL ISLAM [MI] --
# (shares NEXT_PUBLIC_MAPBOX_TOKEN above — declared once)
NEXT_PUBLIC_NAV_REFRESH_MS=15000
NEXT_PUBLIC_IOT_CHART_WINDOW_SECONDS=120
NEXT_PUBLIC_CHAT_MAX_LENGTH=1000
NEXT_PUBLIC_PROMO_PLACEHOLDER=JAMUNA20

# ----------------------------------------------- S. MOONTAHA RAHMAN [SMR] --
NEXT_PUBLIC_GEOFENCE_RADIUS_M=15
NEXT_PUBLIC_GEOFENCE_POLL_SECONDS=10
NEXT_PUBLIC_ENABLE_MOCK_LOCATION=true
NEXT_PUBLIC_PENALTY_GRACE_MINUTES=15
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
