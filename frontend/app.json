{
  "expo": {
    "name": "ParkShareDriver",
    "slug": "ParkShareDriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parksharedriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.ParkShareDriver"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
     [  
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ParkShareDriver to use your location to automatically check you in when you arrive at your parking location.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
     ],
     [
       "expo-splash-screen",
       {
         "backgroundColor": "#208AEF",
         "image": "./assets/images/splash-icon.png",
         "imageWidth": 76
       }
     ]
 ]
    
  }
}
